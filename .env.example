# Local development only. Set https://book.nzesports.org.nz in Vercel Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only — required in production. Without it the portals silently
# fall back to built-in demo data (Harbour Secondary College / Jordan Smith).
SUPABASE_SERVICE_ROLE_KEY=

BREVO_API_KEY=
# Must be a verified email address in Brevo, never a website URL.
BREVO_SENDER_EMAIL=info@esf.nz
BREVO_SENDER_NAME=NZ Esports
BREVO_CONTACT_EMAIL=schools@esf.nz
BREVO_TEACHER_LIST_ID=15

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
# Optional: leave blank to use the mailbox default calendar.
MICROSOFT_GRAPH_CALENDAR_ID=
MICROSOFT_GRAPH_USER_ID=schools@esf.nz
